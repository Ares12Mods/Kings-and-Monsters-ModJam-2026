{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": ["gui"],
        "model": { "type": "minecraft:model", "model": "kingsandmonsters:item/hunters_spear_gui" }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:using_item",
      "on_true": { "type": "minecraft:model", "model": "kingsandmonsters:item/hunters_spear_throwing" },
      "on_false": { "type": "minecraft:model", "model": "kingsandmonsters:item/hunters_spear_held" }
    }
  }
}
